(ns office-life.core
  (:require [office-life.sim.agents :as agents]
            [office-life.sim.world  :as world]))

;; ---- Initialzustand ----

(defn initial-state []
  {:world  (world/initial-world)
   :agents [(agents/new-agent :alice 2.0 6.5 0x4FC3F7 :desk-1)
            (agents/new-agent :bob   5.0 6.5 0xAED581 :desk-2)
            (agents/new-agent :carol 8.0 6.5 0xFFB74D :desk-3)]
   :tick   0})

;; ---- Bewegung (flüssig, Tiles/Sek) ----

(def ^:private move-speed 1.5)

(defn- dist-sq [[px py] [tx ty]]
  (let [dx (- tx px) dy (- ty py)]
    (+ (* dx dx) (* dy dy))))

(defn- move-towards [[px py] [tx ty] dt]
  (let [dx   (- tx px)
        dy   (- ty py)
        dsq  (+ (* dx dx) (* dy dy))
        step (* move-speed dt)]
    (if (<= dsq (* step step))
      [tx ty]
      (let [dist #?(:clj  (Math/sqrt dsq)
                    :cljs (js/Math.sqrt dsq))]
        [(+ px (* (/ dx dist) step))
         (+ py (* (/ dy dist) step))]))))

(defn- arrived? [pos target]
  (<= (dist-sq pos target) 0.04))

;; ---- Hilfsfunktionen Welt ----

(defn- find-obj [world id]
  (->> (:objects world) (filter #(= (:id %) id)) first))

(defn- random-shelf [world]
  (let [shelves (world/find-objects world :shelf)]
    (nth shelves (rand-int (count shelves)))))

;; ---- Agenten-Update (Task-Automat) ----

(defn- find-agent [agents id]
  (first (filter #(= (:id %) id) agents)))

(defn- update-agent [agent world agents dt]
  (->
    (case (:task agent)

      :fetch
      (let [agent   (if (nil? (:shelf-id agent))
                      (assoc agent :shelf-id (:id (random-shelf world)))
                      agent)
            target  (:pos (find-obj world (:shelf-id agent)))
            new-pos (move-towards (:pos agent) target dt)]
        (if (arrived? new-pos target)
          (assoc agent :pos target
                       :moving false
                       :task :take-file
                       :action :take-file
                       :shelf-timer 1.0)
          (assoc agent :pos new-pos :moving true :action :idle)))

      :take-file
      (let [remaining (- (:shelf-timer agent 0.0) dt)]
        (if (<= remaining 0)
          (assoc agent :moving false
                       :task :work
                       :action :idle
                       :shelf-timer 0.0
                       :work-timer (+ 10.0 (rand-int 21)))
          (assoc agent :moving false
                       :action :take-file
                       :shelf-timer remaining)))

      :work
      (let [target  (:pos (find-obj world (:desk-id agent)))
            new-pos (move-towards (:pos agent) target dt)]
        (if (arrived? new-pos target)
          (let [remaining (- (:work-timer agent) dt)]
            (if (<= remaining 0)
              (assoc agent :pos target
                           :moving false
                           :task :return
                           :action :idle
                           :work-timer 0.0)
              (assoc agent :pos target
                           :moving false
                           :action :work
                           :work-timer remaining)))
          (assoc agent :pos new-pos :moving true :action :idle)))

      :return
      (let [target  (:pos (find-obj world (:shelf-id agent)))
            new-pos (move-towards (:pos agent) target dt)]
        (if (arrived? new-pos target)
          (assoc agent :pos target
                       :moving false
                       :task :put-file
                       :action :put-file
                       :shelf-timer 1.0)
          (assoc agent :pos new-pos :moving true :action :idle)))

      :put-file
      (let [remaining (- (:shelf-timer agent 0.0) dt)]
        (if (<= remaining 0)
          (let [next-task (cond
                            (>= (:coffee-need agent 0) 70) :go-coffee
                            (>= (:social agent 0)      70) :seek-chat
                            :else                          :fetch)]
            (assoc agent :moving false
                         :task next-task
                         :action :idle
                         :shelf-timer 0.0
                         :shelf-id nil))
          (assoc agent :moving false
                       :action :put-file
                       :shelf-timer remaining)))

      :go-coffee
      (let [cm      (world/find-object world :coffee-machine)
            target  (:pos cm)
            new-pos (move-towards (:pos agent) target dt)]
        (if (arrived? new-pos target)
          (assoc agent :pos target
                       :moving false
                       :task :drink-coffee
                       :action :drink-coffee
                       :coffee-timer 3.0)
          (assoc agent :pos new-pos :moving true :action :idle)))

      :drink-coffee
      (let [remaining (- (:coffee-timer agent 0.0) dt)]
        (if (<= remaining 0)
          (let [next-task (if (>= (:social agent 0) 70) :seek-chat :fetch)]
            (assoc agent :moving false
                         :task next-task
                         :action :idle
                         :coffee-timer 0.0
                         :coffee-need 0.0))
          (assoc agent :moving false
                       :action :drink-coffee
                       :coffee-timer remaining)))

      :seek-chat
      (let [agent   (if (nil? (:chat-partner-id agent))
                      (let [others  (vec (remove #(= (:id %) (:id agent)) agents))
                            partner (nth others (rand-int (count others)))]
                        (assoc agent :chat-partner-id (:id partner)))
                      agent)
            partner (find-agent agents (:chat-partner-id agent))
            target  (:pos partner)
            new-pos (move-towards (:pos agent) target dt)]
        (if (arrived? new-pos target)
          (assoc agent :pos target :moving false :task :arrived-for-chat :action :chatting)
          (assoc agent :pos new-pos :moving true :action :idle)))

      :arrived-for-chat
      agent

      :chatting
      (let [remaining (- (:chat-timer agent 0.0) dt)]
        (if (<= remaining 0)
          (assoc agent :task :fetch :action :idle
                       :chat-timer 0.0 :chat-partner-id nil :shelf-id nil)
          (assoc agent :action :chatting :chat-timer remaining)))

      :chat-refused
      (let [remaining (- (:chat-timer agent 0.0) dt)]
        (if (<= remaining 0)
          (assoc agent :task :fetch :action :idle
                       :chat-timer 0.0 :chat-partner-id nil :shelf-id nil)
          (assoc agent :action :chat-refused :chat-timer remaining)))

      agent)
    (update :refuse-timer #(max 0 (- (or % 0) dt)))))

;; ---- Chat-Koordination ----

(defn- reconcile-chats [agents]
  (let [seekers (filter #(= (:task %) :arrived-for-chat) agents)]
    (reduce
      (fn [agts seeker]
        (let [partner-id (:chat-partner-id seeker)
              partner    (find-agent agts partner-id)
              willing?   (and partner
                              (not (#{:chatting :arrived-for-chat :seek-chat} (:task partner)))
                              (>= (:social partner 0) 20))]
          (if willing?
            (mapv (fn [a]
                    (cond
                      (= (:id a) (:id seeker))
                      (assoc a :task :chatting :action :chatting
                               :chat-timer (+ 3.0 (rand-int 5)))
                      (= (:id a) partner-id)
                      (assoc a :task :chatting :action :chatting
                               :chat-partner-id (:id seeker)
                               :chat-timer (+ 3.0 (rand-int 5)))
                      :else a))
                  agts)
            (mapv (fn [a]
                    (cond
                      (= (:id a) (:id seeker))
                      (assoc a :task :chat-refused :action :chat-refused
                               :chat-timer 1.5 :chat-partner-id nil)
                      (= (:id a) partner-id)
                      (assoc a :refuse-timer 1.5)
                      :else a))
                  agts))))
      agents
      seekers)))

;; ---- Haupt-Tick ----

(defn tick [state dt]
  (let [world (:world state)
        agts0 (:agents state)
        agts1 (mapv #(update-agent % world agts0 dt) agts0)
        agts2 (reconcile-chats agts1)
        agts3 (mapv #(agents/step-needs % dt) agts2)]
    (-> state
        (assoc :agents agts3)
        (update :tick inc))))
